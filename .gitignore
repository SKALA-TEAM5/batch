dist/
build/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 로그
*.log

# 아티팩트 (폴더 구조는 유지, 파일 제외)
artifacts/*
