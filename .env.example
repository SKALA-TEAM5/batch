# Qdrant local or port-forward:
# kubectl port-forward svc/team5-qdrant 6333:6333 -n skala3-finalproj-class2-team5
QDRANT_URL=http://localhost:6333

# Local development via kubectl port-forward:
# kubectl port-forward svc/team5-postgres 5433:5432 -n skala3-finalproj-class2-team5
# LAW_APP_PASSWORD: check k8s team5-postgres-secret
DATABASE_URL=postgresql://safety_law_app:change-me-law-app-password@localhost:5433/safety

# Law API key (https://open.law.go.kr)
LAW_API_KEY=change-me-law-api-key

# MinIO local or port-forward (API port: 9000, console: 9001):
# kubectl port-forward svc/team5-minio 9000:9000 -n skala3-finalproj-class2-team5
APP_MINIO_ENDPOINT=http://localhost:9000
APP_MINIO_BUCKET=safety-files
APP_MINIO_ACCESS_KEY=change-me-minio-access-key
APP_MINIO_SECRET_KEY=change-me-minio-secret-key

BATCH_MINIO_ENDPOINT=http://localhost:9000
BATCH_MINIO_BUCKET=safety-files
BATCH_MINIO_ACCESS_KEY=change-me-minio-access-key
BATCH_MINIO_SECRET_KEY=change-me-minio-secret-key
BATCH_MINIO_DATA_PREFIX=data/

# Safety doc reference ingest
BATCH_SAFETY_DOC_PREFIX=safety-doc-agent/
BATCH_SAFETY_DOC_DATA_DIR=safety-doc-data/
SAFETY_DOC_COLLECTION=safety-guide
